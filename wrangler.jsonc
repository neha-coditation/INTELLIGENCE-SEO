{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coditation-seo-intelligence",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coditation-seo-db",
      "database_id": "REPLACE_WITH_REAL_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SITE_URL": "https://www.coditation.com/",
    "MAX_PAGES": "40"
  },
  "triggers": { "crons": ["30 3 * * 1", "0 */2 * * *"] }
}
